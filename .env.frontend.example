# Copy to .env.frontend on the server:
#   cp .env.frontend.example .env.frontend
#
# This is a BUILD-TIME value. Next.js inlines NEXT_PUBLIC_* into the client
# bundle, so editing this file only takes effect after a rebuild:
#   docker compose -f docker-compose.frontend.yml --env-file .env.frontend up -d --build

# Public URL of the API, called directly by the browser.
NEXT_PUBLIC_API_URL=https://api.example.com
