# Copy to .env on the server (never commit the filled-in file):
#   cp .env.backend.example .env
# On Dokploy, paste these into the Environment tab instead — Dokploy writes them
# to the .env file that docker-compose.backend.yml reads.

# --- AI providers -------------------------------------------------------------
# Gemini powers embeddings, RAG chat, and quiz generation. A missing or invalid
# GEMINI_API_KEY does not stop the API from starting, but upload, chat, quiz
# and the initial admin seeding will fail.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.6-flash.
# GEMINI_CHAT_MODEL=gemini-3.6-flash

# --- Auth ---------------------------------------------------------------------
# Generate a fresh one: openssl rand -base64 48
JWT_SECRET=

# --- Vector store -------------------------------------------------------------
# Service name on the back-tier network in docker-compose.backend.yml.
CHROMADB_URL=http://chromadb:8000

# --- Networking ---------------------------------------------------------------
# The proxy network the API is published on. Leave unset on Dokploy (it defaults
# to dokploy-network, the only network Dokploy's Traefik routes to). Set to
# "edge" when fronting the stack with docker-compose.proxy.yml instead.
# EDGE_NETWORK=edge

# --- HTTP ---------------------------------------------------------------------
PORT=3003
# Public URL of the frontend. QuizService builds the invitation links emailed to
# candidates from this, so a wrong value sends out dead links. The NEXT_PUBLIC_
# prefix is a misnomer: this is read at runtime by the API, not by the browser.
NEXT_PUBLIC_APP_URL=https://app.example.com
# CORS allowlist, comma-separated. REQUIRED in production: when unset the API
# accepts every origin. A "*" matches a single label, e.g.
# https://*.vercel.app for preview deployments.
FRONTEND_URL=https://app.example.com

# --- Email (OTP verification, quiz invitations) -------------------------------
# All of these are REQUIRED to boot: EmailService and QuizService throw in their
# constructors when they are missing, and Nest aborts startup.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=

# --- First-run admin seed -----------------------------------------------------
# Created on boot if absent. Use a real address and a strong password: this
# account is pre-verified and can manage every user.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
