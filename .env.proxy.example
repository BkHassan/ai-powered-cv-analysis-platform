# Copy to .env.proxy on the server:
#   cp .env.proxy.example .env.proxy
#
# Both hostnames must already resolve to this server (A records) before the
# proxy starts, otherwise the Let's Encrypt challenge fails.

APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# Used for Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com
