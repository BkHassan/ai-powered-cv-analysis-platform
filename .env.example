# Local development. Copy to `.env`, then `docker compose up --build`.
# For Dokploy, paste `.env.backend.example` into the Environment tab instead.

# Gemini covers embeddings, RAG chat, and quiz generation.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.6-flash.
# GEMINI_CHAT_MODEL=gemini-3.6-flash
JWT_SECRET=dev-only-change-me

# Service name from docker-compose.yml.
CHROMADB_URL=http://chromadb:8000
PORT=3003
FRONTEND_URL=http://localhost:3000
# Read by the API (not the browser) to build emailed quiz links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=

ADMIN_EMAIL=admin@craftmind.local
ADMIN_PASSWORD=Admin123!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# apps/frontend/.env.local
# NEXT_PUBLIC_API_URL=http://localhost:3003
